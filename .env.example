# SafeMeds environment template
# Copy this file to .env for local development and fill in real values locally.

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANONYMIZED_TELEMETRY=False

SAFEMEDS_DATA_PATH=backend/data/processed/drug_knowledge_zh.json
DRUG_RESOLUTION_INDEX_PATH=backend/data/processed/drug_resolution_index.json
DRUG_ALIAS_OVERRIDES_PATH=backend/data/raw/drug_alias_overrides.json
SAFEMEDS_STORAGE_DIR=backend/storage
SAFEMEDS_SQLITE_PATH=backend/storage/safemeds_history.sqlite3

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
LLM_ENABLE_EXTRACTION=false
LLM_ENABLE_RESPONSE_GENERATION=true

VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=backend/storage/chroma
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_NAME=lastmass/Qwen3-Embedding-Medical-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

VITE_API_BASE=http://127.0.0.1:8000
